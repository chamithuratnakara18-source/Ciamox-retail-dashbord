rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary password-free preview access for the phone scanner and
    // dashboard category, selling price, and expense edits. Restore
    // authenticated writes for real data.
    match /products/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    match /sales/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /receipts/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    match /suppliers/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /expenses/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /meta/connection {
      allow read: if true;
      allow write: if false;
    }

    // Audit records are server-only. Unknown collections are denied by default.
    match /auditLogs/{document} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
