rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Password-free preview mode: reads are public so the current UI works
    // without a sign-in. Keep browser writes denied; the API remains the write path.
    // Restore staff role checks before exposing this project publicly.
    match /products/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /sales/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /receipts/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /expenses/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /meta/connection {
      allow read: if true;
      allow write: if false;
    }

    // Audit records are server-only. Unknown collections are denied by default.
    match /auditLogs/{document} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
