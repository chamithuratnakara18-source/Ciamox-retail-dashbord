rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInStaff() {
      return request.auth != null
        && request.auth.token.retailRole in ['owner', 'admin', 'manager', 'cashier'];
    }
    function managementStaff() {
      return request.auth != null
        && request.auth.token.retailRole in ['owner', 'admin', 'manager'];
    }

    // Browser clients may read store records after sign-in. Every write goes
    // through the authenticated server API, where roles and business rules are enforced.
    match /products/{document} {
      allow read: if managementStaff();
      allow write: if false;
    }
    match /sales/{document} {
      allow read: if managementStaff();
      allow write: if false;
    }
    match /receipts/{document} {
      allow read: if managementStaff()
        || (signedInStaff() && request.auth.token.retailRole == 'cashier' && document == 'pos-active');
      allow write: if false;
    }
    match /expenses/{document} {
      allow read: if managementStaff();
      allow write: if false;
    }
    match /meta/connection {
      allow read: if managementStaff();
      allow write: if false;
    }

    // Audit records are server-only. Unknown collections are denied by default.
    match /auditLogs/{document} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
